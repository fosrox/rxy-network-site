---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const pdfUrl = "/pdfs/sample-resume.pdf"
import "../styles/global.css"
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      h1 {text-align: center;}

      .resume-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;

      }

    </style>
  </head>
	<body>
		<Header />
		<main>
			<h1>My Résumé</h1>
      <div
      class="resume-actions"
      >
        <a
        class="button"
        href="/pdfs/sample-resume.pdf"
        download="sample-resume.pdf"
        >
          Download Résumé (PDF)
        </a>

        <a class="button" href="/pdfs/sample-resume.pdf" target="_blank">
          Open Résumé in New Tab
        </a>
      </div>
      <iframe
        src={pdfUrl}
        title="Guide PDF"
        width="100%"
        height="1000"
        style="border: none;"
      >
      </iframe>
		</main>
		<Footer />
	</body>
</html>
