---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LinkedInLogo from '../assets/icons/LinkedInLogo_32x32.svg';
import GithubLogo from '../assets/icons/GithubLogo_24x24.svg';
import EnvelopeSymbol from '../assets/icons/PixelEnvelope_32x32.svg';
import CodebergLogo from '../assets/icons/CodebergLogo_24x24.svg';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/resume">Résumé</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/fosrox" target="_blank">
				<span class="sr-only">Go to my Github Profile</span>
				<GithubLogo viewBox={"0 0 24 24"} width={40} height={40} fill={"currentColor"} />
			</a>
			<a href="https://codeberg.org/fosrox" target="_blank">
				<span class="sr-only">Go to my Codeberg Profile</span>
				<CodebergLogo viewBox={"0 0 24 24"} width={40} height={40} fill={"currentColor"} />
			</a>
			<a href="https://www.linkedin.com/in/joshua-fosness-18001a450" target="_blank">
				<span class="sr-only">Go to my Linkedin Profile</span>
				<LinkedInLogo viewBox={"0 0 24 24"} width={40} height={40} fill={"currentColor"} />
			</a>
			<a href="mailto:business@rxy.network" target="_blank">
				<span class="sr-only">Open Email in Client</span>
				<EnvelopeSymbol viewBox={"0 0 24 24"} width={40} height={40} fill={"currentColor"} />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--body);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--white);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
